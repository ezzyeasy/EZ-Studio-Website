---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Preloader from "../components/Preloader.astro";
import LightboxModal from "../components/LightboxModal.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  showPreloader?: boolean;
}

const {
  title = "Ezzy Razman | EZ Studio",
  description = "EZ Studio - Visual Storytelling, Brand Identity, Motion Graphics & Digital Innovation by Ezzy Razman.",
  currentPath = Astro.url.pathname,
  showPreloader = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Bebas Neue & Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2026" />
    <link rel="alternate icon" type="image/svg+xml" href="/Assets/global/Logomark%20ALT%20Light.svg?v=2026" />
  </head>
  <body>
    {showPreloader && <Preloader />}

    <!-- Fixed Atmospheric Tech Grid and Floating Plasma Orbs -->
    <div class="page-bg-effects" aria-hidden="true">
      <div class="bg-grid-overlay"></div>
      <div class="bg-orb orb-1"></div>
      <div class="bg-orb orb-2"></div>
      <div class="bg-orb orb-3"></div>
      <div class="bg-tech-shapes">
        <div class="tech-shape shape-1">+</div>
        <div class="tech-shape shape-2">EZ // 2026</div>
        <div class="tech-shape shape-3">[SYS.ACTIVE]</div>
        <div class="tech-shape shape-4">///</div>
        <div class="tech-shape shape-5">44.3°N</div>
      </div>
    </div>

    <!-- Navigation Header -->
    <Navbar currentPath={currentPath} />

    <!-- Page Main Content Slot -->
    <slot />

    <!-- Global Fullscreen Lightbox Modal -->
    <LightboxModal />

    <!-- Global Footer -->
    <Footer />

    <!-- Client-side Interactive & GSAP Animation Script -->
    <script src="../scripts/animations.js"></script>
  </body>
</html>
