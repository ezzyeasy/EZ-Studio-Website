---
// Signature EZ Studio SVG Outline Preloader Component
---
<div id="preloader" aria-label="Loading page animation">
    <div class="preloader-content">
        <!-- Animated Logomark Outline SVG inside Progress Circle -->
        <svg class="preloader-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1800 1800" width="70" height="70">
            <defs>
                <linearGradient id="gradient-mid" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#fe5d26" />
                    <stop offset="100%" stop-color="#008080" />
                </linearGradient>
                <linearGradient id="gradient-circle" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#008080" />
                    <stop offset="100%" stop-color="#fe5d26" />
                </linearGradient>
            </defs>
            <g class="logo-paths">
                <!-- Enlarged Gradient Progress Circle Wrapper -->
                <g class="preloader-ring-wrapper">
                    <circle class="preloader-ring" cx="900" cy="900" r="840" fill="none"
                        stroke="url(#gradient-circle)" stroke-width="36" stroke-linecap="round"
                        transform="rotate(-90 900 900)" pathLength="100" />
                </g>

                <!-- Center Ribbon Group -->
                <g transform="translate(360, 360)">
                    <path class="path-top" fill="#008080"
                        d="M1039.42,507.79c-1.29,0-2.58-.21-3.83-.65l-499.42-175.17c-4.64-1.63-7.75-6.01-7.75-10.93V11.57c0-3.76,1.82-7.28,4.89-9.45,3.05-2.18,6.98-2.73,10.53-1.48l499.42,175.17c4.64,1.63,7.75,6.01,7.75,10.93v309.47c0,3.76-1.82,7.28-4.89,9.45-1.98,1.41-4.33,2.13-6.7,2.13ZM551.58,312.83l476.25,167.05V194.95L551.58,27.9v284.92Z" />
                    <path class="path-mid" fill="url(#gradient-mid)"
                        d="M1039.42,881.49c-1.29,0-2.58-.21-3.83-.65L36.75,530.5c-4.64-1.63-7.75-6.01-7.75-10.93V210.1c0-3.76,1.82-7.28,4.88-9.45,3.06-2.17,6.98-2.73,10.54-1.48l998.84,350.34c4.64,1.63,7.75,6.01,7.75,10.93v309.47c0,3.76-1.82,7.28-4.88,9.45-1.99,1.4-4.33,2.13-6.7,2.13ZM52.16,511.35l975.67,342.22v-284.92L52.16,226.43v284.92Z" />
                    <path class="path-bot" fill="#fe5d26"
                        d="M540,1080.02c-1.29,0-2.58-.21-3.83-.65L36.75,904.2c-4.64-1.63-7.75-6.01-7.75-10.93v-309.47c0-3.76,1.82-7.28,4.89-9.45,3.05-2.18,6.98-2.73,10.53-1.48l499.42,175.17c4.64,1.63,7.75,6.01,7.75,10.93v309.47c0,3.76-1.82,7.28-4.89,9.45-1.98,1.4-4.33,2.13-6.7,2.13ZM52.16,885.06l476.25,167.04v-284.92L52.16,600.13v284.92Z" />
                </g>
            </g>
        </svg>
        <p class="preloader-text">EZ STUDIO</p>
    </div>
</div>
