<script>
    // Home Page Specific Interactions: About Slideshow & Carousel
    document.addEventListener("DOMContentLoaded", () => {
        // About Slideshow
        const slides = document.querySelectorAll(".about-slideshow .slide-img");
        if (slides.length > 0) {
            let currentSlide = 0;
            setInterval(() => {
                slides[currentSlide].classList.remove("active");
                currentSlide = (currentSlide + 1) % slides.length;
                slides[currentSlide].classList.add("active");
            }, 4000);
        }

        // Featured Track Carousel
        const track = document.getElementById("featuredTrack") as HTMLElement;
        const prevBtn = document.getElementById(
            "prevWorkBtn",
        ) as HTMLButtonElement;
        const nextBtn = document.getElementById(
            "nextWorkBtn",
        ) as HTMLButtonElement;
        const progressBar = document.getElementById(
            "carouselProgressBar",
        ) as HTMLElement;

        if (track && prevBtn && nextBtn && progressBar) {
            const updateControls = () => {
                const maxScroll = track.scrollWidth - track.clientWidth;
                const percentage =
                    maxScroll > 0 ? (track.scrollLeft / maxScroll) * 100 : 0;
                progressBar.style.width = `${25 + percentage * 0.75}%`;
                prevBtn.disabled = track.scrollLeft <= 5;
                nextBtn.disabled = track.scrollLeft >= maxScroll - 5;
            };

            nextBtn.addEventListener("click", () => {
                const card = track.querySelector(
                    ".featured-card",
                ) as HTMLElement;
                if (card) {
                    const stepWidth = card.clientWidth + 32;
                    track.scrollBy({ left: stepWidth, behavior: "smooth" });
                }
            });

            prevBtn.addEventListener("click", () => {
                const card = track.querySelector(
                    ".featured-card",
                ) as HTMLElement;
                if (card) {
                    const stepWidth = card.clientWidth + 32;
                    track.scrollBy({ left: -stepWidth, behavior: "smooth" });
                }
            });

            track.addEventListener("scroll", updateControls, { passive: true });
            window.addEventListener("resize", updateControls, {
                passive: true,
            });
            updateControls();
        }
    });
</script>
