---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroVideo from "../components/HeroVideo.astro";
import "../styles/home.css";
---

<BaseLayout
    title="Ezzy Razman | EZ Studio"
    description="EZ Studio - Creative Multimedia Designer specializing in video editing, motion graphics, 3D and UI/UX."
    currentPath="/"
>
    <!-- Main Content Bounding Box -->
    <main class="main-content">
        <!-- Hero Landing Section -->
        <section class="hero" id="home">
            <HeroVideo mp4Src="/Assets/home/home_main.mp4" />

            <!-- Interactive Grid Overlay & Ambient Glow -->
            <div class="hero-grid-overlay"></div>
            <div class="hero-ambient-glow"></div>

            <div class="hero-content">
                <p class="hero-subtitle">
                    Ezzy Razman’s Portfolio & Creative Studio
                </p>
                <h1 class="hero-title">
                    <span class="word" style="--i: 1;">Made</span>
                    <span class="word" style="--i: 2;">with</span>
                    <span class="word highlight text-glow" style="--i: 3;"
                        >imagination,</span
                    >
                    <br class="desktop-only" /><span
                        class="word"
                        style="--i: 4;">kept</span
                    >
                    <span class="word" style="--i: 5;">as</span>
                    <span
                        class="word highlight text-glow"
                        style="--i: 6;">memories.</span
                    >
                </h1>
                <p class="hero-desc">
                    Creative Director & Designer bridging the gap between
                    high-end aesthetics and clean, immersive interaction
                    development.
                </p>
                <div class="hero-ctas">
                    <a href="#about" class="btn-primary">Explore More</a>
                    <a href="#contact" class="btn-secondary"
                        >Let's Work Together</a
                    >
                </div>
            </div>
        </section>

        <!-- About Identity Section -->
        <section class="about reveal-section" id="about">
            <div class="about-visual reveal-item" style="--reveal-delay: 0.1s;">
                <div class="about-slideshow">
                    <picture>
                        <source
                            srcset="/Assets/home/about_placeholder.webp"
                            type="image/webp"
                        />
                        <img
                            src="/Assets/home/about_placeholder.webp"
                            alt="Ezzy Razman Creative Director"
                            class="slide-img active"
                            width="600"
                            height="800"
                            loading="lazy"
                            decoding="async"
                        />
                    </picture>
                    <picture>
                        <source
                            srcset="/Assets/home/about_placeholder_2.webp"
                            type="image/webp"
                        />
                        <img
                            src="/Assets/home/about_placeholder_2.webp"
                            alt="Multimedia Workspace Design"
                            class="slide-img"
                            width="600"
                            height="800"
                            loading="lazy"
                            decoding="async"
                        />
                    </picture>
                    <picture>
                        <source
                            srcset="/Assets/home/about_placeholder_3.webp"
                            type="image/webp"
                        />
                        <img
                            src="/Assets/home/about_placeholder_3.webp"
                            alt="Digital Creator Process"
                            class="slide-img"
                            width="600"
                            height="800"
                            loading="lazy"
                            decoding="async"
                        />
                    </picture>
                </div>
                <div class="about-visual-overlay"></div>
            </div>

            <div class="about-container">
                <div class="about-spacer"></div>
                <div class="about-info">
                    <span
                        class="about-badge reveal-item"
                        style="--reveal-delay: 0.2s;">01 | About Ezzy</span
                    >
                    <h2
                        class="about-title reveal-item"
                        style="--reveal-delay: 0.3s;"
                    >
                        JUST A MAN, <br class="desktop-only" />WITH <span
                            class="highlight text-glow">BIG DREAMS.</span
                        >
                    </h2>
                    <p
                        class="about-desc reveal-item"
                        style="--reveal-delay: 0.4s;"
                    >
                        Hi! I'm Ezzy, a creative multimedia designer driven by a
                        passion to keep growing and pushing the limits of my
                        craft. My creative journey began at the age of 15 when I
                        first discovered the world of video editing — and I’ve
                        been hooked ever since. Today, as a creative multimedia
                        expert with over four years of experience in the
                        creative industry, I’ve collaborated with multiple
                        companies, bringing ideas to life through design and
                        storytelling. I specialise in video editing, motion
                        graphics, UI/UX, and visual effects. My goal? To become
                        one of the best creators out there and inspire others!
                    </p>
                    <div
                        class="about-actions reveal-item"
                        style="--reveal-delay: 0.5s;"
                    >
                        <a
                            href="https://drive.google.com/file/d/1SLKVZX9aAj9EnKf2xjc5VWCy3XPJVLQT/view?usp=share_link"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-primary"
                            aria-label="Download Resume">Resume</a
                        >
                        <a
                            href="https://www.linkedin.com/in/ezzy-razman-01934a2a9/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-secondary"
                            aria-label="Visit LinkedIn Profile">LinkedIn</a
                        >
                        <a
                            href="/more-about-me.html"
                            class="btn-text"
                            aria-label="Read more about me"
                            >More about me <span class="arrow">→</span></a
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Portfolio Section -->
        <section class="portfolio reveal-section" id="portfolio">
            <div class="portfolio-header">
                <span
                    class="about-badge reveal-item"
                    style="--reveal-delay: 0.1s;">02 | PORTFOLIO</span
                >
                <h2
                    class="portfolio-title reveal-item"
                    style="--reveal-delay: 0.2s;"
                >
                    IMAGINATIVE WORK, <br />CREATED AS <span
                        class="highlight text-glow">REALITY.</span
                    >
                </h2>
            </div>

            <!-- Subsection 1: Worked With -->
            <div
                class="portfolio-clients reveal-item"
                style="--reveal-delay: 0.3s;"
            >
                <p class="clients-subtitle">
                    COLLABORATED WITH INDUSTRY BRANDS
                </p>
                <div class="clients-grid">
                    <div class="client-item" aria-label="Hikayat Fandom">
                        <img
                            src="/Assets/home/Hikayat Fandom logo.svg"
                            alt="Hikayat Fandom"
                            class="client-logo"
                            style="height: 48px;"
                            width="140"
                            height="48"
                            loading="lazy"
                        />
                        <span class="client-tooltip">Hikayat Fandom</span>
                    </div>
                    <div
                        class="client-item"
                        aria-label="Malaysian Youth Performing Arts Club"
                    >
                        <img
                            src="/Assets/home/MYPAC Logo.svg"
                            alt="Malaysian Youth Performing Arts Club"
                            class="client-logo"
                            width="140"
                            height="48"
                            loading="lazy"
                        />
                        <span class="client-tooltip"
                            >Malaysian Youth Performing Arts Club</span
                        >
                    </div>
                    <div class="client-item" aria-label="Keira Works">
                        <img
                            src="/Assets/home/Keira Works Logo.svg"
                            alt="Keira Works"
                            class="client-logo"
                            width="140"
                            height="48"
                            loading="lazy"
                        />
                        <span class="client-tooltip">Keira Works</span>
                    </div>
                    <div class="client-item" aria-label="Havarri Akh. Bhd.">
                        <img
                            src="/Assets/home/Havarri Logo.svg"
                            alt="Havarri Akh. Bhd."
                            class="client-logo"
                            width="140"
                            height="48"
                            loading="lazy"
                        />
                        <span class="client-tooltip">Havarri Akh. Bhd.</span>
                    </div>
                </div>
            </div>

            <!-- Subsection 2: Highlighted Work Carousel -->
            <div
                class="featured-panel-wrapper reveal-item"
                style="--reveal-delay: 0.4s;"
            >
                <div class="portfolio-featured">
                    <div class="featured-header">
                        <h3 class="subsection-title">FEATURED CREATIONS</h3>
                        <div class="carousel-controls">
                            <button
                                class="btn-carousel"
                                id="prevWorkBtn"
                                aria-label="Previous Featured Work"
                                disabled
                            >
                                <svg
                                    viewBox="0 0 24 24"
                                    width="20"
                                    height="20"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    fill="none"
                                >
                                    <line x1="19" y1="12" x2="5" y2="12"></line>
                                    <polyline points="12 19 5 12 12 5"
                                    ></polyline>
                                </svg>
                            </button>
                            <button
                                class="btn-carousel"
                                id="nextWorkBtn"
                                aria-label="Next Featured Work"
                            >
                                <svg
                                    viewBox="0 0 24 24"
                                    width="20"
                                    height="20"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    fill="none"
                                >
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"
                                    ></polyline>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="featured-carousel-wrapper">
                        <div class="featured-track" id="featuredTrack">
                            <!-- Card 1: EPIC X MYPAC OPENING -->
                            <a
                                href="/cinematic-motion.html"
                                class="featured-card"
                                role="group"
                                aria-roledescription="slide"
                                aria-label="1 of 4: EPIC X MYPAC OPENING"
                            >
                                <picture>
                                    <source
                                        srcset="/Assets/home/featured_1.webp"
                                        type="image/webp"
                                    />
                                    <img
                                        src="/Assets/home/featured_1.webp"
                                        alt="Cybernetic Helmet Model"
                                        class="featured-img"
                                        width="500"
                                        height="600"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </picture>
                                <div class="featured-overlay"></div>
                                <div class="featured-info">
                                    <span class="featured-tag"
                                        >CINEMATIC MOTION // 3D MOTION</span
                                    >
                                    <h4 class="featured-card-title">
                                        EPIC X MYPAC OPENING
                                    </h4>
                                </div>
                            </a>

                            <!-- Card 2: MALAYSIA FESTIVAL 2025 -->
                            <a
                                href="/cinematic-visual.html"
                                class="featured-card"
                                role="group"
                                aria-roledescription="slide"
                                aria-label="2 of 4: MALAYSIA FESTIVAL 2025"
                            >
                                <picture>
                                    <source
                                        srcset="/Assets/home/featured_2.webp"
                                        type="image/webp"
                                    />
                                    <img
                                        src="/Assets/home/featured_2.webp"
                                        alt="High-tech sneaker CGI advertisement"
                                        class="featured-img"
                                        width="500"
                                        height="600"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </picture>
                                <div class="featured-overlay"></div>
                                <div class="featured-info">
                                    <span class="featured-tag"
                                        >CINEMATIC VISUAL // VIDEOGRAPHY</span
                                    >
                                    <h4 class="featured-card-title">
                                        MALAYSIA FESTIVAL 2025
                                    </h4>
                                </div>
                            </a>

                            <!-- Card 3: ELDETHOS -->
                            <a
                                href="/digital-form.html"
                                class="featured-card"
                                role="group"
                                aria-roledescription="slide"
                                aria-label="3 of 4: ELDETHOS: ROMANCE OF THE FLAGBEARERS"
                            >
                                <picture>
                                    <source
                                        srcset="/Assets/home/featured_3.webp"
                                        type="image/webp"
                                    />
                                    <img
                                        src="/Assets/home/featured_3.webp"
                                        alt="Aesthetic retro-wave geometric portal"
                                        class="featured-img"
                                        width="500"
                                        height="600"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </picture>
                                <div class="featured-overlay"></div>
                                <div class="featured-info">
                                    <span class="featured-tag"
                                        >DIGITAL FORM // 3D ANIMATION</span
                                    >
                                    <h4 class="featured-card-title">
                                        ELDETHOS: ROMANCE OF THE FLAGBEARERS
                                    </h4>
                                </div>
                            </a>

                            <!-- Card 4: KUALA LUMPUR AFTER DARK -->
                            <a
                                href="/cinematic-visual.html"
                                class="featured-card"
                                role="group"
                                aria-roledescription="slide"
                                aria-label="4 of 4: KUALA LUMPUR AFTER DARK"
                            >
                                <picture>
                                    <source
                                        srcset="/Assets/home/featured_4.webp"
                                        type="image/webp"
                                    />
                                    <img
                                        src="/Assets/home/featured_4.webp"
                                        alt="Music application UI design screens"
                                        class="featured-img"
                                        width="500"
                                        height="600"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </picture>
                                <div class="featured-overlay"></div>
                                <div class="featured-info">
                                    <span class="featured-tag"
                                        >CINEMATIC VISUAL // MONTAGE</span
                                    >
                                    <h4 class="featured-card-title">
                                        KUALA LUMPUR AFTER DARK
                                    </h4>
                                </div>
                            </a>
                        </div>
                    </div>

                    <div class="carousel-progress-container">
                        <div
                            class="carousel-progress-bar"
                            id="carouselProgressBar"
                        >
                        </div>
                    </div>
                </div>
            </div>

            <!-- Subsection 3: Portfolio Divisions (Categories) -->
            <div
                class="portfolio-categories reveal-item"
                style="--reveal-delay: 0.5s;"
            >
                <h3 class="subsection-title text-center text-glow">
                    PORTFOLIO PAGES
                </h3>
                <div class="categories-grid">
                    <!-- Card A: Cinematic Visual -->
                    <a
                        href="/cinematic-visual.html"
                        class="category-card"
                        aria-label="Explore Cinematic Visual portfolio"
                    >
                        <picture>
                            <source
                                srcset="/Assets/home/cat_visual.webp"
                                type="image/webp"
                            />
                            <img
                                src="/Assets/home/cat_visual.webp"
                                alt="Cinematic camera lenses and film production set"
                                class="cat-card-bg"
                                width="400"
                                height="500"
                                loading="lazy"
                                decoding="async"
                            />
                        </picture>
                        <div class="cat-card-overlay"></div>
                        <div class="cat-card-info">
                            <h4 class="cat-card-title">Cinematic Visual</h4>
                            <p class="cat-card-desc">
                                Photography, videography, and editing
                            </p>
                            <div class="cat-card-arrow">
                                <span class="arrow-line"></span>
                                <span class="arrow-head">→</span>
                            </div>
                        </div>
                    </a>

                    <!-- Card B: Design & Identity -->
                    <a
                        href="/design-identity.html"
                        class="category-card"
                        aria-label="Explore Design and Identity portfolio"
                    >
                        <picture>
                            <source
                                srcset="/Assets/home/cat_design.webp"
                                type="image/webp"
                            />
                            <img
                                src="/Assets/home/cat_design.webp"
                                alt="Graphic branding guidelines and poster design frame"
                                class="cat-card-bg"
                                width="400"
                                height="500"
                                loading="lazy"
                                decoding="async"
                            />
                        </picture>
                        <div class="cat-card-overlay"></div>
                        <div class="cat-card-info">
                            <h4 class="cat-card-title">Design & Identity</h4>
                            <p class="cat-card-desc">
                                Graphic and Identity Design
                            </p>
                            <div class="cat-card-arrow">
                                <span class="arrow-line"></span>
                                <span class="arrow-head">→</span>
                            </div>
                        </div>
                    </a>

                    <!-- Card C: Cinematic Motion -->
                    <a
                        href="/cinematic-motion.html"
                        class="category-card"
                        aria-label="Explore Cinematic Motion portfolio"
                    >
                        <picture>
                            <source
                                srcset="/Assets/home/cat_motion.webp"
                                type="image/webp"
                            />
                            <img
                                src="/Assets/home/cat_motion.webp"
                                alt="Fluid wave simulations timeline"
                                class="cat-card-bg"
                                width="400"
                                height="500"
                                loading="lazy"
                                decoding="async"
                            />
                        </picture>
                        <div class="cat-card-overlay"></div>
                        <div class="cat-card-info">
                            <h4 class="cat-card-title">Cinematic Motion</h4>
                            <p class="cat-card-desc">
                                Motion Graphic & Visual Effects
                            </p>
                            <div class="cat-card-arrow">
                                <span class="arrow-line"></span>
                                <span class="arrow-head">→</span>
                            </div>
                        </div>
                    </a>

                    <!-- Card D: Digital Form -->
                    <a
                        href="/digital-form.html"
                        class="category-card"
                        aria-label="Explore Digital Form portfolio"
                    >
                        <picture>
                            <source
                                srcset="/Assets/home/cat_form.webp"
                                type="image/webp"
                            />
                            <img
                                src="/Assets/home/cat_form.webp"
                                alt="3D wireframe spheres and neon matrix"
                                class="cat-card-bg"
                                width="400"
                                height="500"
                                loading="lazy"
                                decoding="async"
                            />
                        </picture>
                        <div class="cat-card-overlay"></div>
                        <div class="cat-card-info">
                            <h4 class="cat-card-title">Digital Form</h4>
                            <p class="cat-card-desc">
                                3D modelling & Animation
                            </p>
                            <div class="cat-card-arrow">
                                <span class="arrow-line"></span>
                                <span class="arrow-head">→</span>
                            </div>
                        </div>
                    </a>

                    <!-- Card E: Web Motion -->
                    <a
                        href="/web-motion.html"
                        class="category-card"
                        aria-label="Explore Web Motion portfolio"
                    >
                        <picture>
                            <source
                                srcset="/Assets/home/cat_web.webp"
                                type="image/webp"
                            />
                            <img
                                src="/Assets/home/cat_web.webp"
                                alt="Sleek glassmorphism website interfaces"
                                class="cat-card-bg"
                                width="400"
                                height="500"
                                loading="lazy"
                                decoding="async"
                            />
                        </picture>
                        <div class="cat-card-overlay"></div>
                        <div class="cat-card-info">
                            <h4 class="cat-card-title">Web Motion</h4>
                            <p class="cat-card-desc">UI/UX & Web Design</p>
                            <div class="cat-card-arrow">
                                <span class="arrow-line"></span>
                                <span class="arrow-head">→</span>
                            </div>
                        </div>
                    </a>

                    <!-- Card F: Printed Work -->
                    <a
                        href="/printed-work.html"
                        class="category-card"
                        aria-label="Explore Printed Work portfolio"
                    >
                        <picture>
                            <source
                                srcset="/Assets/home/cat_print.webp"
                                type="image/webp"
                            />
                            <img
                                src="/Assets/home/cat_print.webp"
                                alt="Typography magazine layout printing mockup"
                                class="cat-card-bg"
                                width="400"
                                height="500"
                                loading="lazy"
                                decoding="async"
                            />
                        </picture>
                        <div class="cat-card-overlay"></div>
                        <div class="cat-card-info">
                            <h4 class="cat-card-title">Printed Work</h4>
                            <p class="cat-card-desc">Publication & Printing</p>
                            <div class="cat-card-arrow">
                                <span class="arrow-line"></span>
                                <span class="arrow-head">→</span>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section class="contact reveal-section" id="contact">
            <div class="contact-container">
                <div
                    class="contact-info-block reveal-item"
                    style="--reveal-delay: 0.1s;"
                >
                    <span class="about-badge">03 | CONNECTION</span>
                    <h2 class="contact-title">
                        LET'S BUILD <br />SOMETHING <span
                            class="highlight text-glow">EXTRAORDINARY.</span
                        >
                    </h2>
                    <p class="contact-desc">
                        Have an idea, project, or collaboration in mind? Feel
                        free to reach out directly or connect with me via my
                        socials!
                    </p>

                    <div class="direct-contact-cards">
                        <a href="tel:+60172292205" class="direct-card">
                            <div class="direct-icon-wrapper">
                                <svg
                                    viewBox="0 0 24 24"
                                    width="20"
                                    height="20"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    fill="none"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path
                                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                                    ></path>
                                </svg>
                            </div>
                            <div class="direct-details">
                                <span class="direct-label">Call / WhatsApp</span
                                >
                                <span class="direct-value">+60172292205</span>
                            </div>
                        </a>

                        <a
                            href="mailto:izzukail.raz@gmail.com"
                            class="direct-card"
                        >
                            <div class="direct-icon-wrapper">
                                <svg
                                    viewBox="0 0 24 24"
                                    width="20"
                                    height="20"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    fill="none"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path
                                        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                                    ></path>
                                    <polyline points="22,6 12,13 2,6"
                                    ></polyline>
                                </svg>
                            </div>
                            <div class="direct-details">
                                <span class="direct-label">Send Email</span>
                                <span class="direct-value"
                                    >izzukail.raz@gmail.com</span
                                >
                            </div>
                        </a>
                    </div>
                </div>

                <div
                    class="contact-socials-block reveal-item"
                    style="--reveal-delay: 0.3s;"
                >
                    <h3 class="subsection-title">DIRECT CONNECTION</h3>
                    <div class="socials-grid">
                        <div class="social-card instagram-card">
                            <div class="social-icon-box">
                                <svg
                                    viewBox="0 0 24 24"
                                    width="24"
                                    height="24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    fill="none"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        x="2"
                                        y="2"
                                        width="20"
                                        height="20"
                                        rx="5"
                                        ry="5"></rect>
                                    <path
                                        d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                                    ></path>
                                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
                                    ></line>
                                </svg>
                            </div>
                            <div class="social-card-info">
                                <span class="social-platform">Instagram</span>
                                <span class="social-handle">@ezzy_razman</span>
                            </div>
                            <a
                                href="https://www.instagram.com/ezzy_razman/"
