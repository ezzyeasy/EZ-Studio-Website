---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/quotation.css';
---

<BaseLayout
  title="Get a Quotation | EZ Studio"
  description="Generate custom instant design and multimedia quotations with EZ Studio's interactive price estimator."
  currentPath="/quotation.html"
>
    <main class="main-content">
        <!-- Portfolio Hero Section -->
        <section class="portfolio-hero reveal-section" style="min-height: 40vh; display: flex; justify-content: center; align-items: center; text-align: center; padding-top: 150px; padding-bottom: 50px;">
            <div class="portfolio-container">
                <span class="portfolio-badge">ONLINE ESTIMATOR</span>
                <h1 class="portfolio-hero-title">
                    GET A <span class="highlight text-glow">QUOTATION.</span>
                </h1>
                <p class="portfolio-hero-desc" style="max-width: 600px; margin: 1.5rem auto 0; color: var(--clr-text-muted);">
                    Select design items, view project specs, and add them to your cart. Download or print your custom
                    quotation instantly.
                </p>
            </div>
        </section>

        <!-- Calculator Section -->
        <section class="cinematic-videos-section reveal-section" id="estimator-section" style="padding-top: 20px;">
            <div class="portfolio-container" style="max-width: 1300px;">

                <!-- Full-Width Featured Curated Bundles Section -->
                <div class="bundles-section-wrapper reveal-item" id="bundlesSection">
                    <div class="bundles-header">
                        <div>
                            <span class="about-badge" style="margin-bottom: 0.4rem; font-size: 0.65rem;">CURATED PACKAGES</span>
                            <h2 class="bundles-main-title">FEATURED SERVICE BUNDLES<span class="highlight text-glow">.</span></h2>
                        </div>
                        <span class="bundles-hint">1-Click Multi-Item Addition</span>
                    </div>

                    <!-- Bundles Grid (Injected by JavaScript) -->
                    <div class="bundles-grid" id="bundlesGrid"></div>
                </div>

                <div class="quotation-layout-grid">
                    <!-- Left Column: Services Browser -->
                    <div class="services-browser-column">
                        <div class="browser-header-tools">
                            <div class="custom-builder-header">
                                <div>
                                    <span class="about-badge" style="margin-bottom: 0.3rem; font-size: 0.65rem;">INDIVIDUAL SERVICES</span>
                                    <h3 class="custom-builder-title">Custom Item Selection<span class="highlight text-glow">.</span></h3>
                                </div>
                            </div>
                            <!-- Search Input -->
                            <div class="search-input-wrapper">
                                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none" class="search-icon">
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                </svg>
                                <input type="text" id="serviceSearchInput" placeholder="Search individual services (e.g. Logo, Photoshoot, Video, 3D)...">
                            </div>
                        </div>

                        <!-- Services Grid (Dynamic JS injection target) -->
                        <div class="services-browser-grid" id="servicesGrid"></div>
                    </div>

                    <!-- Right Column: Sidebar Filters & Cart -->
                    <div class="sticky-sidebar-column">
                        <!-- Category Filters Card -->
                        <div class="sidebar-card">
                            <h3 class="sidebar-card-title">Filter by Category</h3>
                            <div class="filter-pills" id="categoryFilters">
                                <button class="filter-pill active" data-category="all">All Services</button>
                                <button class="filter-pill" data-category="Visual">Cinematic Visual</button>
                                <button class="filter-pill" data-category="Design">Design & Identity</button>
                                <button class="filter-pill" data-category="Motion">Motion Graphics</button>
                                <button class="filter-pill" data-category="Web">Web Motion</button>
                            </div>
                        </div>

                        <!-- Cart Summary Card -->
                        <div class="sidebar-card cart-summary-card">
                            <div class="cart-header-row">
                                <h3 class="sidebar-card-title">Your Selected Items</h3>
                                <button id="btnClearCart" class="btn-clear-cart" title="Remove all items from cart" style="display: none;">
                                    <svg viewBox="0 0 24 24" width="13" height="13" stroke="currentColor" stroke-width="2.5" fill="none">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                    </svg>
                                    <span>Remove All</span>
                                </button>
                            </div>

                            <!-- Selected items list (Dynamic JS injection target) -->
                            <div class="cart-items-list" id="cartItemsList">
                                <div class="cart-empty-message">No items added yet. Click on services to build your quotation.</div>
                            </div>

                            <!-- Cart Subtotal estimation -->
                            <div class="cart-subtotal-block" id="cartSubtotalBlock">
                                <div class="subtotal-row">
                                    <span>Estimated Min Total:</span>
                                    <span class="subtotal-val min" id="subtotalMin">RM0</span>
                                </div>
                                <div class="subtotal-row">
                                    <span>Estimated Max Total:</span>
                                    <span class="subtotal-val max" id="subtotalMax">RM0</span>
                                </div>
                                <div class="subtotal-divider"></div>
                                <div class="subtotal-row total-range-row">
                                    <span>Estimated Subtotal:</span>
                                    <span class="subtotal-val highlight text-glow" id="subtotalRange">RM0</span>
                                </div>
                            </div>

                            <!-- Cart Actions -->
                            <button class="btn-primary" style="width: 100%; border: none; margin-top: 1.5rem; justify-content: center;" id="btnPrintQuotation">
                                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none" style="margin-right: 0.5rem;">
                                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                    <rect x="6" y="14" width="12" height="8"></rect>
                                </svg>
                                Download Quotation PDF
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Dynamic Details Modal Popup -->
    <div class="details-modal" id="detailsModal" aria-hidden="true">
        <div class="details-modal-overlay" id="detailsModalOverlay"></div>
        <div class="details-modal-content">
            <button class="details-modal-close" id="detailsModalCloseBtn" aria-label="Close details popup">
                <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2.5" fill="none">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
            <div class="details-modal-body" id="detailsModalBody"></div>
        </div>
    </div>

    <!-- Printable Invoice/Quotation Sheet -->
    <div class="print-quotation-sheet" id="printQuotationSheet" aria-hidden="true">
        <div class="print-header">
            <div class="print-brand">
                <h1 class="print-logo">EZ STUDIO</h1>
                <p class="print-tagline">Multimedia Design & Storytelling</p>
            </div>
            <div class="print-meta">
                <h2>ESTIMATED QUOTATION</h2>
                <p><strong>Date:</strong> <span id="printDate"></span></p>
                <p><strong>Quotation ID:</strong> <span id="printQuoteId"></span></p>
            </div>
        </div>
        <div class="print-divider"></div>
        <div class="print-details-grid">
            <div class="print-party-col">
                <h3>FROM:</h3>
                <p><strong>EZ Studio (Ezzy Razman)</strong></p>
                <p>Kuala Lumpur, Malaysia</p>
                <p>Email: contact@ezstudio.co</p>
                <p>Tel: +60172292205</p>
            </div>
            <div class="print-party-col">
                <h3>PREPARED FOR:</h3>
                <p>Project Estimation Client</p>
                <p>Self-Service Online Quotation</p>
            </div>
        </div>
        <table class="print-items-table">
            <thead>
                <tr>
                    <th>Service Description</th>
                    <th>Category</th>
                    <th style="text-align: center;">Qty</th>
                    <th style="text-align: right;">Unit Price (Est.)</th>
                    <th style="text-align: right;">Total (Est.)</th>
                </tr>
            </thead>
            <tbody id="printTableBody"></tbody>
        </table>
        <div class="print-totals">
            <div class="print-totals-row">
                <span>Minimum Estimation:</span>
                <span id="printTotalMin">RM0</span>
            </div>
            <div class="print-totals-row">
                <span>Maximum Estimation:</span>
                <span id="printTotalMax">RM0</span>
            </div>
            <div class="print-totals-row print-grand-total">
                <span>Estimated Subtotal Range:</span>
                <span id="printTotalRange">RM0</span>
            </div>
        </div>
        <div class="print-notes">
            <h4>Estimation Notes & Terms</h4>
            <p>1. This is a self-generated online quotation estimate. Final pricing may vary depending on project complexity, revisions, and exact scope parameters agreed upon during booking.</p>
            <p>2. To lock in this quotation, please contact Ezzy Razman directly referencing your Quotation ID.</p>
        </div>
        <div class="print-footer">
            <p>Thank you for considering EZ Studio. Let's make something amazing together!</p>
        </div>
    </div>

    <!-- Load Quotation Interactive Logic -->
    <script src="../scripts/quotation.js"></script>
</BaseLayout>
