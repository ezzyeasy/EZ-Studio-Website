<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Video Control Pill
        const bgVideo = document.getElementById('bg-intro-video') as HTMLVideoElement;
        const playPauseBtn = document.querySelector('.btn-play-pause') as HTMLElement;
        const muteBtn = document.querySelector('.btn-mute') as HTMLElement;
        const timelineBar = document.querySelector('.timeline-bar') as HTMLElement;
        const timelineProgress = document.querySelector('.timeline-progress') as HTMLElement;
        const timeElapsed = document.querySelector('.time-elapsed') as HTMLElement;
        const timeTotal = document.querySelector('.time-total') as HTMLElement;
        const controlPill = document.getElementById('videoControlPill') as HTMLElement;
        const pillToggleBtn = document.getElementById('pillToggleBtn') as HTMLElement;

        if (controlPill && pillToggleBtn) {
            pillToggleBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                const isExpanded = controlPill.classList.toggle('expanded');
                pillToggleBtn.setAttribute('aria-expanded', String(isExpanded));
            });

            document.addEventListener('click', (e) => {
                if (!controlPill.contains(e.target as Node) && controlPill.classList.contains('expanded')) {
                    controlPill.classList.remove('expanded');
                    pillToggleBtn.setAttribute('aria-expanded', 'false');
                }
            });
        }

        if (bgVideo && playPauseBtn && muteBtn && timelineBar && timelineProgress && timeElapsed && timeTotal) {
            const playIcon = playPauseBtn.querySelector('.icon-play') as HTMLElement;
            const pauseIcon = playPauseBtn.querySelector('.icon-pause') as HTMLElement;
            const muteIcon = muteBtn.querySelector('.icon-mute') as HTMLElement;
            const unmuteIcon = muteBtn.querySelector('.icon-unmute') as HTMLElement;

            const formatTime = (timeInSeconds: number) => {
                if (isNaN(timeInSeconds) || timeInSeconds === Infinity) return '0:00';
                const mins = Math.floor(timeInSeconds / 60);
                const secs = Math.floor(timeInSeconds % 60);
                return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
            };

            const initDuration = () => {
                if (bgVideo.duration && !isNaN(bgVideo.duration)) {
                    timeTotal.textContent = formatTime(bgVideo.duration);
                }
            };

            bgVideo.addEventListener('loadedmetadata', initDuration);
            bgVideo.addEventListener('durationchange', initDuration);
            bgVideo.addEventListener('canplay', initDuration);
            initDuration();

            playPauseBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (bgVideo.paused) {
                    bgVideo.play();
                    if (playIcon) playIcon.style.display = 'none';
                    if (pauseIcon) pauseIcon.style.display = 'block';
                } else {
                    bgVideo.pause();
                    if (playIcon) playIcon.style.display = 'block';
                    if (pauseIcon) pauseIcon.style.display = 'none';
                }
            });

            muteBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                bgVideo.muted = !bgVideo.muted;
                if (bgVideo.muted) {
                    if (muteIcon) muteIcon.style.display = 'block';
                    if (unmuteIcon) unmuteIcon.style.display = 'none';
                } else {
                    if (muteIcon) muteIcon.style.display = 'none';
                    if (unmuteIcon) unmuteIcon.style.display = 'block';
                }
            });

            bgVideo.addEventListener('timeupdate', () => {
                if (!bgVideo.duration || isNaN(bgVideo.duration)) return;
                const percentage = (bgVideo.currentTime / bgVideo.duration) * 100;
                timelineProgress.style.width = `${percentage}%`;
                timeElapsed.textContent = formatTime(bgVideo.currentTime);
            });

            timelineBar.addEventListener('click', (e) => {
                e.stopPropagation();
                if (!bgVideo.duration || isNaN(bgVideo.duration)) return;
                const rect = timelineBar.getBoundingClientRect();
                const clickPosition = (e.clientX - rect.left) / rect.width;
                bgVideo.currentTime = clickPosition * bgVideo.duration;
            });
        }

        // Accordion Details
        const expItems = document.querySelectorAll('.exp-item');
        expItems.forEach(item => {
            const header = item.querySelector('.exp-header') as HTMLElement;
            const content = item.querySelector('.exp-content') as HTMLElement;

            if (header && content) {
                header.addEventListener('click', (e) => {
                    e.preventDefault();
                    const isActive = item.classList.contains('active');

                    item.classList.toggle('active');
                    header.setAttribute('aria-expanded', String(!isActive));
                    content.setAttribute('aria-hidden', String(isActive));

                    if (!isActive) {
                        content.style.maxHeight = content.scrollHeight + 'px';
                        content.style.opacity = '1';
                    } else {
                        content.style.maxHeight = '0';
                        content.style.opacity = '0';
                    }
                });
            }
        });
    });
</script>
