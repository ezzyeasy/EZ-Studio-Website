---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/legal.css";
---

<BaseLayout
    title="Privacy Policy | EZ Studio"
    description="Privacy Policy for EZ Studio and creative portfolio services by Ezzy Razman."
    currentPath="/privacy.html"
>
    <main class="main-content">
        <!-- Hero Section -->
        <section class="legal-hero">
            <div class="legal-hero-glow"></div>
            <div class="legal-hero-content">
                <div class="legal-back-nav">
                    <a href="/" class="legal-back-link">
                        <svg
                            viewBox="0 0 24 24"
                            width="16"
                            height="16"
                            stroke="currentColor"
                            stroke-width="2.5"
                            fill="none"
                        >
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        Back to Home
                    </a>
                </div>
                <span class="legal-badge">LEGAL // PRIVACY</span>
                <h1 class="legal-title">
                    PRIVACY <span class="highlight text-glow">POLICY.</span>
                </h1>
                <p class="legal-desc">
                    Your privacy is important to us. This policy outlines how EZ
                    Studio collects, uses, and protects any information you
                    provide while exploring this portfolio or collaborating with
                    us.
                </p>
                <div class="legal-meta-bar">
                    <span class="legal-meta-dot"></span>
                    <span>Last Updated: September 2026</span>
                    <span>•</span>
                    <span>Status: Active</span>
                </div>
            </div>
        </section>

        <!-- Content Section -->
        <section class="legal-section">
            <div class="legal-container">
                <div class="legal-card">
                    <!-- Informative Notice Banner -->
                    <div class="legal-banner">
                        <svg
                            class="legal-banner-icon"
                            viewBox="0 0 24 24"
                            width="22"
                            height="22"
                            stroke="currentColor"
                            stroke-width="2"
                            fill="none"
                        >
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <div class="legal-banner-text">
                            <strong>Note for Visitors:</strong> This document contains
                            preliminary guidelines for EZ Studio. We may update this
                            Privacy Policy from time to time. Any changes will be
                            posted on this page with an updated revision date. We
                            encourage you to review this policy periodically.
                        </div>
                    </div>

                    <article class="legal-article">
                        <!-- Clause 01: Overview -->
                        <div class="legal-block" id="section-overview">
                            <div class="legal-block-header">
                                <span class="legal-block-num">01</span>
                                <h2 class="legal-block-title">
                                    Overview & Introduction
                                </h2>
                            </div>
                            <p>
                                Welcome to EZ Studio (accessible via our primary
                                website and portfolio domains). This Privacy
                                Policy explains our practices regarding the
                                collection, use, and disclosure of information
                                that we receive through our website and creative
                                services.
                            </p>
                            <p>
                                By accessing or using our website, you
                                acknowledge that you have read and understood
                                this policy. If you have questions or require
                                further clarification, please reach out
                                directly.
                            </p>
                            <p>
                                This Privacy Policy describes how EZ STUDIO
                                ("we," "us," or "our") collects, uses, and
                                shares information when you visit our website.
                                As a creative multimedia solo studio, we respect
                                your privacy and are committed to protecting
                                your personal data.
                            </p>
                        </div>

                        <!-- Clause 02: Information Collected -->
                        <div class="legal-block" id="section-collection">
                            <div class="legal-block-header">
                                <span class="legal-block-num">02</span>
                                <h2 class="legal-block-title">
                                    Information We Collect
                                </h2>
                            </div>
                            <p>
                                We may collect personal and technical
                                information in the following contexts:
                            </p>
                            <ul>
                                <li>
                                    <strong>Contact & Inquiries:</strong> If you reach
                                    out through a contact form, we collect the information
                                    you provide, such as your name, email address,
                                    and message content. This is used only to respond
                                    to your corporate or individual inquiry.
                                </li>
                                <li>
                                    <strong>Technical & Usage Data:</strong> We collect
                                    technical and usage data to improve our website.
                                    This includes IP addresses, browser type, operating
                                    system, pages visited, and interaction patterns.
                                    This information is aggregated to understand website
                                    usage and is not used to personally identify visitors.
                                </li>
                            </ul>
                            <div class="legal-callout">
                                <p>
                                    <strong>Commitment:</strong> We do not sell, rent,
                                    or trade your personal contact details to third-party
                                    marketing brokers under any circumstance.
                                </p>
                            </div>
                        </div>

                        <!-- Clause 03: How Information Is Used -->
                        <div class="legal-block" id="section-usage">
                            <div class="legal-block-header">
                                <span class="legal-block-num">03</span>
                                <h2 class="legal-block-title">
                                    How We Use Your Information
                                </h2>
                            </div>
                            <p>
                                Any information gathered is used exclusively for
                                legitimate business and artistic collaboration
                                purposes, including:
                            </p>
                            <ul>
                                <li>
                                    To respond to your corporate and individual
                                    inquiries and project communications
                                </li>
                                <li>
                                    To improve our website, portfolio
                                    presentation, and content based on usage
                                    patterns
                                </li>
                                <li>
                                    To maintain the security and functionality
                                    of our site
                                </li>
                            </ul>
                        </div>

                        <!-- Clause 04: Media & Intellectual Assets -->
                        <div class="legal-block" id="section-media">
                            <div class="legal-block-header">
                                <span class="legal-block-num">04</span>
                                <h2 class="legal-block-title">
                                    Media & Client Assets
                                </h2>
                            </div>
                            <p>
                                <strong>Ownership and Creative Rights:</strong> All
                                creative assets, media productions, motion graphics,
                                video recordings, photography, brand identity designs,
                                and deliverables produced by EZ STUDIO remain the
                                exclusive intellectual property of the studio unless
                                a full transfer of rights or explicit licensing agreement
                                has been executed in writing.
                            </p>
                            <p>
                                <strong>Portfolio and Showcase Rights:</strong> EZ
                                STUDIO retains the perpetual, non-exclusive right
                                to display, showcase, and publish all completed works,
                                project files, and associated media assets across
                                digital portfolios, social media platforms, award
                                submissions, and marketing materials for promotional
                                purposes, subject to prior delivery or public release
                                by the client.
                            </p>
                        </div>

                        <!-- Clause 05: Third-Party Services -->
                        <div class="legal-block" id="section-thirdparty">
                            <div class="legal-block-header">
                                <span class="legal-block-num">05</span>
                                <h2 class="legal-block-title">
                                    External Links & Third-Party Platforms
                                </h2>
                            </div>
                            <p>
                                Our portfolio contains links to external
                                platforms such as YouTube, Behance, LinkedIn,
                                Instagram, GitHub, and Google Drive. Please note
                                that these external websites operate under their
                                own independent privacy policies, and EZ Studio
                                is not responsible for their data collection
                                practices.
                            </p>
                        </div>

                        <!-- Clause 06: Data Security -->
                        <div class="legal-block" id="section-security">
                            <div class="legal-block-header">
                                <span class="legal-block-num">06</span>
                                <h2 class="legal-block-title">
                                    Data Security & Retention
                                </h2>
                            </div>
                            <p>
                                We employ reasonable administrative, technical,
                                and physical safeguards to protect information
                                against loss, theft, and unauthorized access.
                                Information is retained only as long as
                                necessary to fulfill project needs or legal
                                obligations.
                            </p>
                            <p>
                                We do not sell, trade, or rent your personal
                                information to third parties. We may share data
                                with service providers who help us operate our
                                website (such as email delivery services or
                                analytics providers), but only as necessary for
                                them to perform their services.
                            </p>
                        </div>

                        <!-- Clause 07: Contact -->
                        <div class="legal-block" id="section-contact">
                            <div class="legal-block-header">
                                <span class="legal-block-num">07</span>
                                <h2 class="legal-block-title">
                                    Contact & Privacy Requests
                                </h2>
                            </div>
                            <p>
                                If you wish to update, review, or request
                                deletion of any personal information provided to
                                EZ Studio, please contact Ezzy Razman directly:
                            </p>
                            <div class="legal-contact-box">
                                <div class="legal-contact-info">
                                    <span class="legal-contact-name"
                                        >Ezzy Razman // EZ Studio</span
                                    >
                                    <a
                                        href="mailto:izzukail.raz@gmail.com"
                                        class="legal-contact-email"
                                        >izzukail.raz@gmail.com</a
                                    >
                                    <span
                                        style="font-size: 0.8rem; color: var(--clr-text-muted);"
                                        >Kuala Lumpur, Malaysia • +60172292205</span
                                    >
                                </div>
                                <a href="/#contact" class="btn-legal-contact">
                                    <span>Get In Touch</span>
                                    <svg
                                        viewBox="0 0 24 24"
                                        width="14"
                                        height="14"
                                        stroke="currentColor"
                                        stroke-width="2.5"
                                        fill="none"
                                    >
                                        <line x1="5" y1="12" x2="19" y2="12"
                                        ></line>
                                        <polyline points="12 5 19 12 12 19"
                                        ></polyline>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
