---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/legal.css";
---

<BaseLayout
    title="Terms & Policy | EZ Studio"
    description="Terms of service, project collaboration policies, and creative service guidelines for EZ Studio."
    currentPath="/policy.html"
>
    <main class="main-content">
        <!-- Hero Section -->
        <section class="legal-hero">
            <div
                class="legal-hero-glow"
                style="background: radial-gradient(circle, rgba(254, 93, 38, 0.16) 0%, rgba(0, 128, 128, 0.05) 50%, transparent 70%);"
            >
            </div>
            <div class="legal-hero-content">
                <div class="legal-back-nav">
                    <a href="/" class="legal-back-link">
                        <svg
                            viewBox="0 0 24 24"
                            width="16"
                            height="16"
                            stroke="currentColor"
                            stroke-width="2.5"
                            fill="none"
                        >
                            <line x1="19" y1="12" x2="5" y2="12"></line>
                            <polyline points="12 19 5 12 12 5"></polyline>
                        </svg>
                        Back to Home
                    </a>
                </div>
                <span
                    class="legal-badge"
                    style="color: #00ffff; border-color: rgba(0, 255, 255, 0.3); background: rgba(0, 255, 255, 0.06);"
                    >LEGAL // TERMS & CONDITIONS</span
                >
                <h1 class="legal-title">
                    TERMS & <span class="highlight text-glow">POLICY.</span>
                </h1>
                <p class="legal-desc">
                    These terms govern creative project engagements, multimedia
                    commissions, and usage conditions when collaborating with EZ
                    Studio.
                </p>
                <div class="legal-meta-bar">
                    <span
                        class="legal-meta-dot"
                        style="background-color: var(--clr-accent); box-shadow: 0 0 8px var(--clr-accent);"
                    ></span>
                    <span>Last Updated: September 2026</span>
                    <span>•</span>
                    <span>Version 1.0 (Placeholder)</span>
                </div>
            </div>
        </section>

        <!-- Content Section -->
        <section class="legal-section">
            <div class="legal-container">
                <div class="legal-card">
                    <!-- Informative Notice Banner -->
                    <div
                        class="legal-banner"
                        style="border-color: rgba(254, 93, 38, 0.25); background: rgba(254, 93, 38, 0.06);"
                    >
                        <svg
                            class="legal-banner-icon"
                            viewBox="0 0 24 24"
                            width="22"
                            height="22"
                            stroke="currentColor"
                            stroke-width="2"
                            fill="none"
                            style="color: var(--clr-accent);"
                        >
                            <polygon points="12 2 2 22 22 22 12 2"></polygon>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        <div class="legal-banner-text">
                            <strong>Service Guidelines Notice:</strong> This page
                            serves as a structured placeholder template for EZ Studio's
                            business terms, project milestone policies, and service
                            contracts. You can easily edit or replace any text block
                            below.
                        </div>
                    </div>

                    <article class="legal-article">
                        <!-- Clause 01: Agreement & Acceptance -->
                        <div class="legal-block" id="section-agreement">
                            <div class="legal-block-header">
                                <span class="legal-block-num">01</span>
                                <h2 class="legal-block-title">
                                    Agreement & Acceptance of Terms
                                </h2>
                            </div>
                            <p>
                                By commissioning creative work, approving an
                                instant quotation, or entering into a creative
                                agreement with EZ Studio, you agree to comply
                                with and be bound by the terms, conditions, and
                                operational policies detailed herein.
                            </p>
                            <p>
                                Any specialized or project-specific contract
                                signed between EZ Studio and the client shall
                                supersede these general terms in the event of
                                any conflict.
                            </p>
                        </div>

                        <!-- Clause 02: Creative Scopes & Quotations -->
                        <div class="legal-block" id="section-scope">
                            <div class="legal-block-header">
                                <span class="legal-block-num">02</span>
                                <h2 class="legal-block-title">
                                    Project Scopes & Instant Quotations
                                </h2>
                            </div>
                            <p>
                                All estimates generated through our online
                                quotation system represent non-binding
                                preliminary price estimations based on standard
                                parameters:
                            </p>
                            <ul>
                                <li>
                                    <strong>Quotations Validity:</strong> Custom quotations
                                    are generally valid for 30 calendar days from
                                    the date of issue unless specified otherwise.
                                </li>
                                <li>
                                    <strong>Scope Clarity:</strong> Detailed asset
                                    resolutions, delivery formats (e.g. 4K video,
                                    vector logos, raw 3D assets), and turnaround dates
                                    are finalized in the formal agreement before project
                                    kickoff.
                                </li>
                                <li>
                                    <strong>Out-of-Scope Requests:</strong> Additional
                                    feature requests, extra visual effect shots, or
                                    major conceptual shifts beyond the agreed brief
                                    will be quoted as separate milestone items.
                                </li>
                            </ul>
                        </div>

                        <!-- Clause 03: Milestone Deliverables & Reviews -->
                        <div class="legal-block" id="section-revisions">
                            <div class="legal-block-header">
                                <span class="legal-block-num">03</span>
                                <h2 class="legal-block-title">
                                    Revision Rounds & Approvals
                                </h2>
                            </div>
                            <p>
                                To ensure high artistic quality and timely
                                production delivery, projects operate under
                                iterative review cycles:
                            </p>
                            <ul>
                                <li>
                                    Standard creative deliverables typically
                                    include up to <strong
                                        >2 rounds of revisions</strong
                                    > during draft milestones.
                                </li>
                                <li>
                                    Client feedback should be consolidated and
                                    provided within reasonable review timeframes
                                    to maintain scheduled delivery milestones.
                                </li>
                                <li>
                                    Final approval of master files indicates
                                    project sign-off and authorizes final
                                    delivery packaging.
                                </li>
                            </ul>
                            <div class="legal-callout">
                                <p>
                                    <strong>Quality Guarantee:</strong> EZ Studio
                                    is dedicated to ensuring visual excellence and
                                    brand integrity across every motion graphic, video
                                    edit, and graphic design artifact.
                                </p>
                            </div>
                        </div>

                        <!-- Clause 04: Intellectual Property & Rights -->
                        <div class="legal-block" id="section-ip">
                            <div class="legal-block-header">
                                <span class="legal-block-num">04</span>
                                <h2 class="legal-block-title">
                                    Intellectual Property & Portfolio Rights
                                </h2>
                            </div>
                            <p>Upon receipt of final payment in full:</p>
                            <ul>
                                <li>
                                    <strong>Client Ownership:</strong> The client
                                    receives the agreed commercial usage rights to
                                    the final rendered deliverables as defined in
                                    the project scope.
                                </li>
                                <li>
                                    <strong>Working Files:</strong> Proprietary project
                                    source files (such as raw After Effects comp structures,
                                    3D project hierarchies, and raw brush setups)
                                    remain the intellectual property of EZ Studio
                                    unless explicitly purchased as an asset deliverable.
                                </li>
                                <li>
                                    <strong>Portfolio Presentation:</strong> EZ Studio
                                    reserves the right to showcase the completed work
                                    in promotional reels, website portfolios, social
                                    media showcases, and artistic case studies.
                                </li>
                            </ul>
                        </div>

                        <!-- Clause 05: Payments & Milestones -->
                        <div class="legal-block" id="section-payment">
                            <div class="legal-block-header">
                                <span class="legal-block-num">05</span>
                                <h2 class="legal-block-title">
                                    Payment Terms & Milestones
                                </h2>
                            </div>
                            <p>
                                Standard project payments follow milestone
                                structures (such as a 50% commencement deposit
                                and 50% upon final delivery approval). Invoices
                                are payable via bank transfer or approved
                                digital payment methods within the designated
                                payment schedule.
                            </p>
                        </div>

                        <!-- Clause 06: Project Postponement or Cancellation -->
                        <div class="legal-block" id="section-cancellation">
                            <div class="legal-block-header">
                                <span class="legal-block-num">06</span>
                                <h2 class="legal-block-title">
                                    Cancellation & Postponement Policy
                                </h2>
                            </div>
                            <p>
                                Should a project be cancelled or placed on
                                indefinite hold by the client after kickoff,
                                compensation will be calculated pro-rata based
                                on completed work hours and milestones achieved
                                up to that date.
                            </p>
                        </div>

                        <!-- Clause 07: Inquiries & Consultations -->
                        <div class="legal-block" id="section-inquiries">
                            <div class="legal-block-header">
                                <span class="legal-block-num">07</span>
                                <h2 class="legal-block-title">
                                    Questions & Custom Inquiries
                                </h2>
                            </div>
                            <p>
                                Have questions regarding our creative terms,
                                special licensing needs, or specific
                                collaboration arrangements? Let's discuss your
                                project requirements:
                            </p>
                            <div class="legal-contact-box">
                                <div class="legal-contact-info">
                                    <span class="legal-contact-name"
                                        >Ezzy Razman // EZ Studio</span
                                    >
                                    <a
                                        href="mailto:izzukail.raz@gmail.com"
                                        class="legal-contact-email"
                                        >izzukail.raz@gmail.com</a
                                    >
                                    <span
                                        style="font-size: 0.8rem; color: var(--clr-text-muted);"
                                        >Creative Direction & Multimedia
                                        Production • Kuala Lumpur</span
                                    >
                                </div>
                                <a href="/#contact" class="btn-legal-contact">
                                    <span>Contact Ezzy</span>
                                    <svg
                                        viewBox="0 0 24 24"
                                        width="14"
                                        height="14"
                                        stroke="currentColor"
                                        stroke-width="2.5"
                                        fill="none"
                                    >
                                        <line x1="5" y1="12" x2="19" y2="12"
                                        ></line>
                                        <polyline points="12 5 19 12 12 19"
                                        ></polyline>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
